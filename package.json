{
  "name": "yosoynathel-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:site": "bun --cwd apps/site run dev",
    "dev:photos": "bun --cwd apps/photos run dev",
    "build:site": "bun --cwd apps/site run build",
    "build:photos": "bun --cwd apps/photos run build",
    "sync": "bun --cwd apps/site run sync"
  }
}
